# Pinned inputs for the Crawl acceptance test. Every value can be overridden from the environment.
SURFACE=python
REPO=zenrows-python-sdk

# The official images, pinned by digest so two runs agree.
NODE_IMAGE="${NODE_IMAGE:-node:20@sha256:8f693eaa7e0a8e71560c9a82b55fd54c2ae920a2ba5d2cde28bac7d1c01c9ba5}"
PYTHON_IMAGE="${PYTHON_IMAGE:-python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1}"
GO_IMAGE="${GO_IMAGE:-golang:1.25@sha256:699337d620559a59b4a2bb298ad59611e535d2ee755a34cf2d2a98f37578dc80}"

# Tools the build and the checks install.
PNPM_VERSION="${PNPM_VERSION:-9.4.0}"
PY_BUILD_VERSION="${PY_BUILD_VERSION:-1.2.2.post1}"
MCP_SDK_VERSION="${MCP_SDK_VERSION:-1.27.1}"
TYPESCRIPT_VERSION="${TYPESCRIPT_VERSION:-5.7.3}"
MYPY_VERSION="${MYPY_VERSION:-1.15.0}"

# What to crawl.
CRAWL_URL="${CRAWL_URL:-https://www.scrapingcourse.com/ecommerce/}"
CRAWL_INCLUDE="${CRAWL_INCLUDE:-/product/}"
CRAWL_API_BASE="${CRAWL_API_BASE:-https://api.zenrows.com/v1}"

# REF unset tests this checkout. Set it to a SHA, branch or tag to test that commit from GitHub.
REF="${REF:-}"
