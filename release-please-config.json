{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "skip-changelog": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Other",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "zenrows",
      "exclude-paths": [
        "acceptance"
      ],
      "extra-files": [
        "src/zenrows/__version__.py",
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value==\"zenrows\")].version"
        }
      ]
    }
  }
}
